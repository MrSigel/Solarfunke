# Supabase – Lead-Persistenz + CRM-Auth. Werte in .env.local eintragen bzw. in
# den Deployment-Umgebungsvariablen (z. B. Vercel Project Settings) setzen.
# Der anon-Key ist per Design öffentlich (RLS schützt die Daten).
NEXT_PUBLIC_SUPABASE_URL=https://<dein-projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dein-anon-key>

# Strato SMTP – Versand der Bestätigungsmail (nur serverseitig, keine Secrets ins Repo).
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kontakt@solarfunke.de
SMTP_PASSWORD=<dein-smtp-passwort>
MAIL_FROM=Solarfunke <noreply@solarfunke.de>
